DIAGNOSTIC_IMAGE=valvue3-runtime:0.1.3
OCR_IMAGE=valvue3-ocr:0.1.3
RUNTIME_TARGET=runtime
CODEX_VERSION=0.159.2
# Optional WPS layer: change RUNTIME_TARGET to with-wps, supply installer and SHA256.
WPS_DEB_SHA256=
# setup writes your Linux UID/GID here. No auth or API keys in this file.
LOCAL_UID=1000
LOCAL_GID=1000
PROJECTS_DIR=./离线诊断/projects
STATE_DIR=./.runtime
OCR_THREADS=4
# Enable only after reading docs/DOCKER.md and testing the ordinary profile.
# COMPOSE_FILE=compose.yaml:compose.isolation.yaml
# Ubuntu with restricted user namespaces: load docker/valvue3-diagnostic.apparmor first.
# DIAGNOSTIC_APPARMOR_PROFILE=valvue3-diagnostic
